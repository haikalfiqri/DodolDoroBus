{
  "name": "codex-trial",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "build": "node db/migrate.mjs && vite build",
    "db:setup": "node db/migrate.mjs",
    "typecheck": "tsc -p .",
